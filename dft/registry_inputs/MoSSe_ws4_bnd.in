&CONTROL
  calculation = 'bands'
  verbosity = 'high'
  prefix = 'pw'
  outdir = './tmp'
  pseudo_dir = './pseudos'
  tefield = .true.
  dipfield = .true.
  disk_io = 'medium'
/
&SYSTEM
  ibrav = 0
  nat = 6
  ntyp = 3
  ecutwfc = 90
  nbnd = 48
  occupations = 'smearing'
  smearing = 'cold'
  degauss = 0.005
  edir = 3
  emaxpos = 0.05
  eopreg = 0.10
  eamp = 0.0
  vdw_corr = 'dft-d3'
/
&ELECTRONS
  conv_thr = 1e-08
  mixing_beta = 0.3
  electron_maxstep = 250
  diagonalization = 'david'
/
