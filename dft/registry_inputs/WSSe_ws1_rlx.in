&CONTROL
  calculation = 'relax'
  prefix = 'pw'
  outdir = './tmp'
  pseudo_dir = './pseudos'
  forc_conv_thr = 0.0001
  nstep = 200
  tefield = .true.
  dipfield = .true.
  disk_io = 'medium'
/
&SYSTEM
  ibrav = 0
  nat = 6
  ntyp = 3
  ecutwfc = 90
  occupations = 'smearing'
  smearing = 'cold'
  degauss = 0.005
  edir = 3
  emaxpos = 0.05
  eopreg = 0.10
  eamp = 0.0
  vdw_corr = 'dft-d3'
/
&ELECTRONS
  conv_thr = 1e-08
  mixing_beta = 0.3
  electron_maxstep = 250
  diagonalization = 'david'
/
&IONS
/
ATOMIC_SPECIES
  S 32.06 S.upf
  Se 78.971 Se.upf
  W 183.84 W.upf
CELL_PARAMETERS angstrom
  3.2349000000 0.0000000000 0.0000000000
  -1.6174500000 2.8015055787 0.0000000000
  0.0000000000 0.0000000000 30.0000000000
ATOMIC_POSITIONS crystal
  W 0.0000000000 0.0000000000 0.3820605625 0 0 1
  S 0.3333333333 0.6666666667 0.3306710391 0 0 1
  Se 0.3333333333 0.6666666667 0.4392886590 0 0 1
  W 0.1666666667 0.5000000000 0.6123422908 0 0 1
  S 0.5000000000 0.1666666667 0.5610332998 0 0 1
  Se 0.5000000000 0.1666666667 0.6696041487 0 0 1
K_POINTS automatic
  6 6 1 0 0 0
