&control
  calculation = 'vc-relax'
  prefix = 'wsse'
  outdir = './tmp_wsse'
  pseudo_dir = './pseudo'
  etot_conv_thr = 1.0d-6
  forc_conv_thr = 1.0d-4
  tefield = .true.
  dipfield = .true.
/
&system
  ibrav = 4
  a = 3.27
  c = 20.0
  nat = 3
  ntyp = 3
  ecutwfc = 60.0
  ecutrho = 480.0
  occupations = 'fixed'
  edir = 3
  emaxpos = 0.05
  eopreg = 0.03
  eamp = 0.0
/
&electrons
  conv_thr = 1.0d-8
  mixing_beta = 0.2
  mixing_mode = 'local-TF'
/
&ions
/
&cell
  cell_dofree = '2Dxy'
  press_conv_thr = 0.1
/
